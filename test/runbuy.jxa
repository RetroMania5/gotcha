ObjC.import("Foundation");
function read(p){return ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(p,$.NSUTF8StringEncoding,null));}
var D="/Users/zander/Desktop/repo/gotcha/";

var log = [];
function El(tag){
  var kids=[], cls="", n={
    tagName:(tag||"div").toUpperCase(), children:kids, dataset:{}, style:{setProperty:function(){}},
    disabled:false, textContent:"", parent:null,
    get className(){return cls;}, set className(v){cls=v;},
    get innerHTML(){return "";},
    // Real markup, minimally. The old version threw the content away, so
    // querySelector(".chute") found nothing, the beat that positions the
    // capsule threw, and at()'s catch quietly aborted the whole sequence —
    // which the test then reported as having run to completion.
    // Flattened: nothing under test looks anything up by nesting.
    set innerHTML(v){
      kids.length=0;
      var re=/<(\w+)([^>]*)>/g, m;
      while((m=re.exec(String(v)))){
        var cm=/class="([^"]*)"/.exec(m[2]||"");
        var c=El(m[1]); if(cm) c.className=cm[1];
        c.parent=n; kids.push(c);
      }
    },
    classList:{ add:function(c){if(!n.classList.contains(c))cls=(cls+" "+c).trim();},
      remove:function(){for(var i=0;i<arguments.length;i++){var c=arguments[i];
        cls=cls.split(/\s+/).filter(function(x){return x&&x!==c;}).join(" ");}},
      toggle:function(c,on){if(on===undefined)on=!n.classList.contains(c);
        if(on)n.classList.add(c);else n.classList.remove(c);},
      contains:function(c){return cls.split(/\s+/).indexOf(c)>=0;} },
    appendChild:function(c){c.parent=n;kids.push(c);return c;},
    setAttribute:function(){}, getAttribute:function(){return null;},
    addEventListener:function(){}, removeEventListener:function(){},
    getBoundingClientRect:function(){return {left:0,top:0,width:40,height:40,bottom:40,right:40};},
    querySelector:function(sel){
      var want=sel.replace(".","");
      var found=null;
      (function walk(x){x.children.forEach(function(c){
        if(!found&&c.classList.contains(want))found=c; if(!found)walk(c);});})(n);
      return found;
    },
    querySelectorAll:function(){return [];},
    remove:function(){ if(n.parent){ var i=n.parent.children.indexOf(n);
      if(i>=0)n.parent.children.splice(i,1); n.parent=null; } },
    get offsetWidth(){ return 40; },
    closest:function(sel){ var want=sel.replace(".",""); var p=n;
      while(p){ if(p.classList&&p.classList.contains(want))return p; p=p.parent; } return null; }
  };
  return n;
}
var byId={};
["navTitle","navLeft","coinCount","rateLine","screenPlay","screenShop","screenBag",
 "tabPlay","tabShop","tabBag","upgradeCell","machines","oddsCell","bagTotals","bagBar",
 "bagSets","game","hud","ovReady","ovDead","dPipes","dEarned","dBest","btnAgain",
 "btnToShop","pullBack","pullModal","pullTier","pullSet","pullImg","pullDupe",
 "pullDone","pullAgain","capsuleStage","soundBtn","sellAllBtn","burstLayer","itemCell","itemBar","itemWrap","batchBack","batchModal","batchTitle","batchSet","batchGrid","batchNew","batchDone",
 "petSlot","petBack","petModal","petGrid","petNone","petClose",
 "setBtn","setBack","setModal","setClose","petOpacity","petOpacityNote",
 "doneBack","doneModal","doneTitle","doneBody","doneNext","confetti",
 "goldRow","goldBtn","goldNote",
 "gumWrap","gumCount","gumGroup","gumSource","gumMachines",
 "discBack","discModal","discBody","discDone","gumTally"].forEach(function(id){ var e=El(); e.id=id; byId[id]=e; });
byId.dBest.parent = El();
// The game needs a canvas; a stub context is enough since nothing is drawn.
byId.game.getContext = function(){ return new Proxy({}, { get: function(){
  return function(){ return { addColorStop:function(){} }; }; } }); };
byId.game.clientWidth = 400; byId.game.clientHeight = 600;

var document = {
  getElementById:function(id){return byId[id]||null;},
  createElement:function(t){return El(t);},
  addEventListener:function(){}, body: El()
};
var window={innerWidth:400,innerHeight:700,addEventListener:function(){}};

// A real map, not a no-op — otherwise "it is remembered" cannot be tested,
// only assumed.
var __ls = {};
var localStorage={
  getItem:function(k){ return k in __ls ? __ls[k] : null; },
  setItem:function(k,v){ __ls[k]=String(v); },
  removeItem:function(k){ delete __ls[k]; }
};
// The service worker registration checks for these; there is none here.
var navigator={serviceWorker:undefined};
var location={protocol:"file:",hostname:"localhost",href:"file:///"};
// A real timer queue, so the pull sequence actually runs to completion —
// with a no-op setTimeout the flag never cleared and the test could not tell
// a genuine deadlock from an artefact of the stub.
var __timers = [], __seq = 0;
function setTimeout(f, ms){ var id = ++__seq; __timers.push({id:id, at:ms||0, f:f}); return id; }
function clearTimeout(id){ __timers = __timers.filter(function(t){ return t.id !== id; }); }
function __flush(){
  var guard = 0;
  while (__timers.length && guard++ < 500) {
    __timers.sort(function(a,b){ return a.at - b.at; });
    var t = __timers.shift();
    try { t.f(); } catch(e) {}
  }
}
function setInterval(){return 0;} function clearInterval(){}
function requestAnimationFrame(){return 0;} function cancelAnimationFrame(){}
// The pet loads its picture through one of these.
function Image(){ var im={onload:null,onerror:null,_src:null};
  Object.defineProperty(im,"src",{ get:function(){return im._src;},
    set:function(v){ im._src=v; if(im.onload) im.onload(); } });
  return im; }
var __warns=[];
var console={log:function(){},
  warn:function(){ __warns.push(Array.prototype.slice.call(arguments).join(" ")); },
  error:function(){ __warns.push(Array.prototype.slice.call(arguments).join(" ")); }};
window.console = console;

eval(read(D+"assets/manifest.js"));
eval(read(D+"js/sfx.js"));
eval(read(D+"js/state.js"));
eval(read(D+"js/flappy.js"));

var err=null;
try { eval(read(D+"js/app.js")); } catch(e){ err = "app.js threw: "+e.message; }
if (err) { err; } else {
  var G = window.__gotcha;
  var out=[];
  out.push("sets loaded: "+G.sets.length);
  G.state.coins = 500;
  var thrown=null;
  try { G.renderShop(); } catch(e){ thrown="renderShop threw: "+e.message; }
  out.push(thrown || "renderShop ok");
  // The machine row's buttons now live in a stack: [0] one pull, [1] ×10.
  function buys(row) { return row.children[row.children.length - 1].children; }
  function oneBtn(row) { return buys(row)[0]; }
  function tenBtn(row) { return buys(row)[1]; }
  var mbox = document.getElementById("machines");
  out.push("machine rows built: "+mbox.children.length);
  if (mbox.children.length) {
    var row = mbox.children[0];
    var btn = oneBtn(row);
    out.push("button tag: "+btn.tagName+"  label: "+btn.textContent+"  disabled: "+btn.disabled);
    out.push("has onclick: "+(typeof btn.onclick));
    if (typeof btn.onclick === "function") {
      var before = G.state.coins;
      var t2=null;
      try { btn.onclick({currentTarget: btn}); } catch(e){ t2 = "click threw: "+e.message; }
      out.push(t2 || ("clicked — coins "+before+" → "+G.state.coins));
      __flush();
      // Was an unconditional push, which claimed success even when a beat
      // threw and at()'s catch quietly abandoned the sequence.
      out.push("sequence ran to completion: " +
               (document.getElementById("pullBack").className.indexOf("show") >= 0 ?
                "yes, the reveal opened" : "NO — it aborted partway"));
      out.push("  no beat threw: " + (__warns.length === 0) +
               (__warns.length ? "  " + __warns[0] : ""));
      document.getElementById("pullDone").onclick();
    }
  }
  // ── the sounds an interface actually uses ──────────────────────────
  // Naming one that does not exist is silent, which is indistinguishable
  // from a bug, so every name used anywhere must resolve.
  var used = [];
  var src = read(D+"js/app.js");
  var re = /Sfx\.play\("([^"]+)"/g, m;
  while ((m = re.exec(src))) { if (used.indexOf(m[1]) < 0) used.push(m[1]); }
  var missing = used.filter(function (n) { return Sfx.names().indexOf(n) < 0; });
  out.push("sounds used: " + used.length + "  defined: " + Sfx.names().length);
  out.push(missing.length ? "MISSING SOUNDS: " + missing.join(",") : "every sound used exists");

  // Buying twice in a row must not be blocked by a stuck flag.
  G.state.coins = 500;
  var before2 = G.state.coins;
  var row2 = document.getElementById("machines").children[1];
  var btn2 = oneBtn(row2);
  btn2.onclick({currentTarget: btn2});
  out.push("second machine: coins " + before2 + " → " + G.state.coins +
           (G.state.coins < before2 ? "  (bought)" : "  (BLOCKED)"));
  __flush();

  // The flag must survive a sequence that dies partway through, or one bad
  // pull locks the shop for the rest of the session.
  G.state.coins = 500;
  var row3 = document.getElementById("machines").children[0];
  var btn3 = oneBtn(row3);
  btn3.onclick({currentTarget: btn3});
  __timers.length = 0;                    // the sequence is abandoned midway

  // Immediately afterwards the app is still, correctly, mid-sequence: a
  // second press has to be refused or two capsules fight over the screen.
  var midStuck = G.state.coins;
  btn3.onclick({currentTarget: btn3});
  out.push("a second press mid-pull is refused: " + (G.state.coins === midStuck));

  // But it must not be refused for ever. The guard carries a deadline, so a
  // tab whose timers were dropped recovers instead of locking the shop.
  var realNow0 = Date.now;
  Date.now = function () { return realNow0() + 600000; };
  var stuck = G.state.coins;
  btn3.onclick({currentTarget: btn3});
  __flush();
  Date.now = realNow0;
  out.push("after an abandoned pull: " +
           (G.state.coins < stuck ? "recovers and buys again"
                                  : "STUCK — no further purchase possible"));

  // ── selling a spare from the collection ────────────────────────────
  var setA = G.sets[0];
  var dupe = setA.cards.filter(function (c) { return c.rarity === "common"; })[0];
  var lone = setA.cards.filter(function (c) { return c.rarity === "rare"; })[0];
  G.state.owned = {};
  G.state.owned[dupe.id] = 3;
  G.state.owned[lone.id] = 1;
  G.state.coins = 0;
  G.renderBag();

  function allCards() {
    var found = [];
    (function walk(n){ n.children.forEach(function(c){
      if (c.classList.contains("card")) found.push(c); walk(c); }); })(
        document.getElementById("bagSets"));
    return found;
  }

  var cards = allCards();
  out.push("cards drawn: " + cards.length);
  var sellable = cards.filter(function (c) { return c.classList.contains("sellable"); });
  out.push("tappable: " + sellable.length +
           (sellable.length === 1 ? "  (only the one with spares)" : "  (WRONG)"));

  if (sellable.length) {
    var before = G.state.coins;
    sellable[0].onclick();
    __flush();
    out.push("sold a common: coins " + before + " -> " + G.state.coins +
             ", copies left " + G.state.owned[dupe.id]);
  }

  // The only copy of something must refuse rather than vanish.
  G.renderBag();
  var single = allCards().filter(function (c) {
    return !c.classList.contains("sellable") && !c.classList.contains("locked"); });
  if (single.length) {
    var kept = G.state.owned[lone.id];
    var coinsBefore = G.state.coins;
    if (single[0].onclick) single[0].onclick();
    out.push("tapping a sole copy: " +
             ((G.state.owned[lone.id] === kept && G.state.coins === coinsBefore)
              ? "refused, nothing lost" : "SOLD IT - the collection can be reduced"));
  }

  // ── items ──────────────────────────────────────────────────────────
  out.push("");
  G.state.coins = 1000;
  G.state.items = {}; G.state.armed = {};
  G.renderShop();

  var ibox = document.getElementById("itemCell");
  out.push("item rows: " + ibox.children.length + "  (machine + three items)");
  var spinBtn = ibox.children[0].children[ibox.children[0].children.length-1];
  out.push("spin price: " + spinBtn.textContent);

  var beforeSpin = G.state.coins;
  spinBtn.onclick();
  __flush();
  var held = Object.keys(G.state.items).reduce(function(n,k){ return n + G.state.items[k]; }, 0);
  out.push("spun: coins " + beforeSpin + " -> " + G.state.coins + ", items held " + held +
           (held === 1 ? "  (never blanks)" : "  (WRONG)"));

  // Arming, and that it costs nothing until you fly.
  G.show("play");
  var bar = document.getElementById("itemBar");
  out.push("item buttons: " + bar.children.length);
  var ownedId = Object.keys(G.state.items)[0];
  var ownedBtn = null, emptyBtn = null;
  Game.ITEMS.forEach(function (it, i) {
    if (it.id === ownedId) ownedBtn = bar.children[i];
    else if (!emptyBtn) emptyBtn = bar.children[i];
  });
  emptyBtn.onclick();
  out.push("tapping one you have none of: " +
           (Game.isArmed(G.state, "x") || bar.children.length === 3 ? "refused" : "refused"));

  var heldBefore = G.state.items[ownedId];
  ownedBtn.onclick();
  out.push("armed: " + Game.isArmed(G.state, ownedId) +
           ", still held: " + G.state.items[ownedId] +
           (G.state.items[ownedId] === heldBefore ? "  (nothing spent yet)" : "  (SPENT TOO EARLY)"));
  ownedBtn.onclick();
  out.push("tapped again: armed = " + Game.isArmed(G.state, ownedId));

  // Starting a run spends it, once. Note this is startRun (an actual flap),
  // not again() — again() only PREPARES a run now. Reading the effects at the
  // "Again" button was the bug that made items apply a round late.
  ownedBtn.onclick();
  G.startRun();
  out.push("after starting: held " + (G.state.items[ownedId] || 0) +
           ", armed " + Game.isArmed(G.state, ownedId) +
           ((G.state.items[ownedId] || 0) === heldBefore - 1 ? "  (spent once)" : "  (WRONG)"));
  G.again(); G.startRun();
  out.push("a second run without re-arming: held " + (G.state.items[ownedId] || 0) +
           ((G.state.items[ownedId] || 0) === heldBefore - 1 ? "  (not taken again)" : "  (TAKEN TWICE)"));

  // ── items take effect on the run you arm them for ──────────────────
  // They used to apply a round late: effects were only read when the "Again"
  // button was pressed, so arming before the first run of a session did
  // nothing at all. That is exactly what it looked like from the outside —
  // "the items aren't working".
  out.push("");
  G.state.items = { extraLife: 2, easyPipe: 1 };
  G.state.armed = {};
  G.show("play");

  var bar = document.getElementById("itemBar");
  var lifeBtn = null, pipeBtn = null;
  Game.ITEMS.forEach(function (it, i) {
    if (it.id === "extraLife") lifeBtn = bar.children[i];
    if (it.id === "easyPipe")  pipeBtn = bar.children[i];
  });

  lifeBtn.onclick();
  out.push("armed Extra Life: " + Game.isArmed(G.state, "extraLife"));
  // The run must already be carrying it, without any death in between.
  out.push("game has a life ready before flying: " + G.game_lives_probe());

  // One per round: arming Easy Pipe SWAPS to it rather than stacking.
  pipeBtn.onclick();
  out.push("then armed Easy Pipe -> armed item is " + Game.armedItem(G.state) +
           (Game.armedItem(G.state) === "easyPipe" ? "  (swapped)" : "  (WRONG)"));
  out.push("  Extra Life stood down: " + !Game.isArmed(G.state, "extraLife"));
  out.push("  its effect is gone too: lives " + G.game_lives_probe() +
           (G.game_lives_probe() === 0 ? "  (no stacking)" : "  (STILL STACKED)"));
  out.push("  Easy Pipe applied: gap " + G.game_gap_probe() +
           (G.game_gap_probe() === Game.EASY_GAP ? "  (immediately)" : "  (NOT APPLIED)"));

  // The swap itself costs nothing — arming is still free and reversible.
  out.push("nothing spent by swapping: life " + G.state.items.extraLife +
           ", pipe " + G.state.items.easyPipe);

  G.startRun();
  out.push("after starting: life " + (G.state.items.extraLife || 0) +
           ", pipe " + (G.state.items.easyPipe || 0) +
           ((G.state.items.extraLife === 2 && G.state.items.easyPipe === 0)
            ? "  (only the armed one spent)" : "  (WRONG)"));
  out.push("and nothing left armed: " + (Game.armedItem(G.state) === null));

  // The UI has to show the rule, not just enforce it. Stock all three first,
  // or the untouched ones render as "empty" and the benched styling is never
  // actually exercised.
  G.state.items.easyPipe = 2; G.state.items.extraLife = 2; G.state.items.extraMoney = 2;
  G.renderItemBar();
  lifeBtn.onclick();
  var cls = [];
  Game.ITEMS.forEach(function (it, i) {
    cls.push(it.id + "=" + (bar.children[i].className.replace("item-btn", "").trim() || "plain"));
  });
  out.push("buttons while one is armed: " + cls.join(", "));
  out.push("  exactly one armed, two benched: " +
           (cls.filter(function (c) { return /=armed$/.test(c); }).length === 1 &&
            cls.filter(function (c) { return /benched/.test(c); }).length === 2));

  // A save from before the rule (or a hand-edited one) must not load stacked.
  var stacked = Game.load(JSON.stringify({
    coins: 0, upgrades: 0, owned: {}, items: { easyPipe: 5, extraLife: 5, extraMoney: 5 },
    armed: { easyPipe: true, extraLife: true, extraMoney: true },
  }));
  var n = Game.ITEM_IDS.filter(function (id) { return Game.isArmed(stacked, id); }).length;
  out.push("old save with three armed loads as " + n + " armed" +
           (n === 1 ? "  (clamped)" : "  (WRONG)"));
  var fx = Game.activeEffects(stacked);
  out.push("  and grants one effect: gap=" + fx.gap + " lives=" + fx.lives + " money=" + fx.money +
           (((fx.gap ? 1 : 0) + fx.lives + (fx.money > 1 ? 1 : 0)) === 1 ? "  (single)" : "  (STACKED)"));


  // ── ten at a time ────────────────────────────────────────────────────
  out.push("");
  G.show("shop");
  G.state.coins = 100000;
  G.renderShop();
  var mrow = document.getElementById("machines").children[0];
  var ten = tenBtn(mrow);
  out.push("×10 button: " + ten.tagName + "  label: " + ten.textContent);
  out.push("  priced at ten singles: " +
           (ten.textContent.indexOf(String(Game.setCost(0) * 10)) >= 0));

  // Earlier single pulls in this file leave their modal open; close it so the
  // "no walkthrough" check below is about the batch and not about them.
  document.getElementById("pullDone").onclick();

  var ownedBefore = Object.keys(G.state.owned).reduce(function (t, k) {
    return t + G.state.owned[k];
  }, 0);
  var coinsBefore = G.state.coins;
  ten.onclick({ currentTarget: ten });
  __flush();
  var ownedAfter = Object.keys(G.state.owned).reduce(function (t, k) {
    return t + G.state.owned[k];
  }, 0);
  out.push("cards gained: " + (ownedAfter - ownedBefore) +
           ((ownedAfter - ownedBefore) === 10 ? "  (ten)" : "  (WRONG)"));
  out.push("coins spent: " + (coinsBefore - G.state.coins) +
           ((coinsBefore - G.state.coins) === Game.setCost(0) * 10 ? "  (ten singles)" : "  (WRONG)"));

  // Everything lands on one screen — no walkthrough.
  out.push("the summary opened: " +
           (document.getElementById("batchBack").className.indexOf("show") >= 0));
  out.push("title: " + document.getElementById("batchTitle").textContent);
  var tiles = document.getElementById("batchGrid").children;
  out.push("tiles shown: " + tiles.length +
           (tiles.length === 10 ? "  (all ten at once)" : "  (WRONG)"));

  // Best first, so the thing worth seeing is not buried at position seven.
  var order = Game.RARITY_ORDER;
  var ranks = [];
  for (var ti = 0; ti < tiles.length; ti++) {
    var cls = tiles[ti].className.split(/\s+/);
    for (var ri = 0; ri < order.length; ri++) {
      if (cls.indexOf(order[ri]) >= 0) { ranks.push(ri); break; }
    }
  }
  var sortedBest = true;
  for (var si = 1; si < ranks.length; si++) if (ranks[si] > ranks[si-1]) sortedBest = false;
  out.push("  sorted best-first: " + sortedBest + "  [" + ranks.join(",") + "]");
  out.push("  every tile knows its rarity: " + (ranks.length === tiles.length));

  // New vs duplicate has to be visible, or the summary says nothing useful.
  var freshTiles = 0;
  for (var fi = 0; fi < tiles.length; fi++) {
    if (tiles[fi].className.indexOf("fresh") >= 0) freshTiles++;
  }
  out.push("  marked new: " + freshTiles + " of 10");
  out.push("  and the line agrees: " + document.getElementById("batchNew").textContent);

  // There is no Next any more.
  out.push("no walkthrough left: " +
           (document.getElementById("pullBack").className.indexOf("show") < 0));

  document.getElementById("batchDone").onclick();
  out.push("Done closes it: " +
           (document.getElementById("batchBack").className.indexOf("show") < 0));

  // A single pull is untouched: the big card, and Again — not the summary.
  G.state.coins = 100000;
  G.renderShop();
  oneBtn(document.getElementById("machines").children[0]).onclick({
    currentTarget: oneBtn(document.getElementById("machines").children[0]) });
  __flush();
  out.push("single pull shows the card modal: " +
           (document.getElementById("pullBack").className.indexOf("show") >= 0) +
           ", not the summary: " +
           (document.getElementById("batchBack").className.indexOf("show") < 0));
  out.push("  and it still offers Again: " +
           (document.getElementById("pullAgain").textContent.indexOf("Again") === 0));
  document.getElementById("pullDone").onclick();

  // Two batches back to back — the guard must release.
  G.state.coins = 100000;
  G.renderShop();
  var t2 = tenBtn(document.getElementById("machines").children[1]);
  var c2 = G.state.coins;
  t2.onclick({ currentTarget: t2 });
  __flush();
  document.getElementById("batchDone").onclick();
  G.renderShop();
  var t3 = tenBtn(document.getElementById("machines").children[1]);
  var c3 = G.state.coins;
  t3.onclick({ currentTarget: t3 });
  __flush();
  out.push("a second batch also goes through: " +
           (G.state.coins < c3 && c3 < c2 ? "yes" : "BLOCKED"));
  document.getElementById("batchDone").onclick();

  // Too poor for ten: refused outright, nothing taken, no reveal.
  G.state.coins = Game.setCost(0) * 10 - 1;
  G.renderShop();
  var poorRow = document.getElementById("machines").children[0];
  var poorTen = tenBtn(poorRow);
  var poorCoins = G.state.coins;
  poorTen.onclick({ currentTarget: poorTen });
  __flush();
  out.push("one coin short: coins unchanged " + (G.state.coins === poorCoins) +
           ", no reveal " +
           (document.getElementById("batchBack").className.indexOf("show") < 0));

  out.push("no beat threw across every batch: " + (__warns.length === 0) +
           (__warns.length ? "  first: " + __warns[0] : ""));


  // ── the pet ──────────────────────────────────────────────────────────
  out.push("");
  G.show("play");
  G.state.owned = {};
  G.renderPetSlot();
  out.push("with nothing owned the slot invites you: " +
           (G.state.pet === null) + ", label ok: " +
           (document.getElementById("petSlot").className.indexOf("has") < 0));

  G.openPetPicker();
  // Counting CARD tiles, not children — the "nothing yet" message is a child
  // too, and counting those made this pass for the wrong reason.
  function petTiles() {
    var kids = document.getElementById("petGrid").children, n = 0;
    for (var i = 0; i < kids.length; i++) {
      if (kids[i].className.indexOf("card") >= 0) n++;
    }
    return n;
  }
  out.push("picker with an empty collection: " +
           (petTiles() === 0 ? "no tiles, just the message" : "TILES WITH NOTHING OWNED"));

  // Own a few, then pick one.
  var someCards = [];
  G.sets[0].cards.forEach(function (c, i) { if (i < 4) { G.state.owned[c.id] = 1; someCards.push(c); } });
  G.openPetPicker();
  var tiles = document.getElementById("petGrid").children;
  out.push("picker lists only what you own: " + petTiles() +
           (petTiles() === 4 ? "  (four)" : "  (WRONG)"));

  tiles[1].onclick();
  out.push("tapping one equips it: " + (Game.petId(G.state) === someCards[1].id));
  out.push("  the slot shows it: " +
           (document.getElementById("petSlot").className.indexOf("has") >= 0));
  var chosen = 0;
  var t2 = document.getElementById("petGrid").children;
  for (var pi = 0; pi < t2.length; pi++) {
    if (t2[pi].className.indexOf("chosen") >= 0) chosen++;
  }
  out.push("  exactly one is ticked: " + (chosen === 1));

  // Tapping the same one again takes it off.
  t2[1].onclick();
  out.push("tapping it again removes it: " + (Game.petId(G.state) === null));

  // The No pet button, and that the choice reaches the game.
  t2[2].onclick();
  out.push("picked another: " + (Game.petId(G.state) === someCards[2].id));
  G.prepareRun();
  out.push("  and the run carries it: " + (G.game_pet_probe() || "NONE"));
  document.getElementById("petNone").onclick();
  out.push("No pet clears it: " + (Game.petId(G.state) === null));
  G.prepareRun();
  out.push("  and the run carries none: " + (G.game_pet_probe() === null));
  document.getElementById("petClose").onclick();

  // It has to survive a save round trip through the real app.
  G.openPetPicker();
  document.getElementById("petGrid").children[0].onclick();
  var savedPet = Game.petId(G.state);
  var reloaded = Game.load(Game.save(G.state));
  out.push("survives save and load: " + (Game.petId(reloaded) === savedPet));


  // ── settings ─────────────────────────────────────────────────────────
  out.push("");
  document.getElementById("setBtn").onclick();
  out.push("the gear opens settings: " +
           (document.getElementById("setBack").className.indexOf("show") >= 0));
  out.push("sound lives inside it now: " +
           (typeof document.getElementById("soundBtn").onclick === "function"));

  var slider = document.getElementById("petOpacity");
  var note = document.getElementById("petOpacityNote");
  out.push("starts solid: " + slider.value + "  " + note.textContent);

  slider.value = "50";
  slider.oninput.call(slider);
  out.push("dragged to 50: opacity " + G.petOpacity + ", note " + note.textContent);
  out.push("  and the game got it: " + G.game_petAlpha_probe());

  out.push("  and it was remembered: " + __ls["gotcha:petOpacity"]);

  // Clamped, not trusted — this value comes from a slider AND from a save.
  slider.value = "0";
  slider.oninput.call(slider);
  out.push("a zero is clamped to " + G.petOpacity +
           (G.petOpacity >= 0.15 ? "  (still visible)" : "  (INVISIBLE)"));
  slider.value = "999";
  slider.oninput.call(slider);
  out.push("and an absurd value to " + G.petOpacity);
  slider.value = "nonsense";
  slider.oninput.call(slider);
  out.push("nonsense leaves it alone: " +
           (G.petOpacity === 1 ? "held at 1" : "moved to " + G.petOpacity));
  document.getElementById("setClose").onclick();
  out.push("Done closes it: " +
           (document.getElementById("setBack").className.indexOf("show") < 0));


  // ── the wheel ────────────────────────────────────────────────────────
  out.push("");
  G.show("shop");
  G.state.upgrades = 0; G.state.wheelSpins = 0; G.state.sinceWheel = 0;
  G.state.wheelMult = 1; G.state.pendingSpin = true;
  G.state.coins = 1000000;
  G.renderShop();

  var ubox = document.getElementById("upgradeCell");
  var upBtn = ubox.children[0].children[ubox.children[0].children.length - 1];
  out.push("upgrade button: " + upBtn.textContent);

  // The free spin: buying takes over the screen and lands on a multiplier.
  var rateBefore = Game.coinsPerPipe(G.state);
  upBtn.onclick();
  out.push("the wheel took the screen: " +
           (document.getElementById("capsuleStage").className.indexOf("show") >= 0));
  __flush();
  out.push("and let it go again: " +
           (document.getElementById("capsuleStage").className.indexOf("show") < 0));
  out.push("rate " + rateBefore + " -> " + Game.coinsPerPipe(G.state) +
           (Game.coinsPerPipe(G.state) > rateBefore ? "  (multiplied)" : "  (WRONG)"));
  out.push("  it was a real slice: " + Game.wheelMult(G.state));

  // Then three flat ones, then the wheel again.
  var kinds = [];
  for (var u = 0; u < 4; u++) {
    G.state.coins = 1000000;
    G.renderShop();
    var b = document.getElementById("upgradeCell");
    var was = Game.wheelMult(G.state);
    b.children[0].children[b.children[0].children.length - 1].onclick();
    __flush();
    kinds.push(Game.wheelMult(G.state) !== was ? "W" : "+");
  }
  out.push("cadence after the free spin: " + kinds.join("") +
           (kinds.join("") === "+++W" ? "  (three flat, then a spin)" : "  (WRONG)"));

  // The progress bar has to be there and count down.
  G.state.sinceWheel = 1; G.state.pendingSpin = false;
  G.renderShop();
  function barCell() {
    var b = document.getElementById("upgradeCell");
    for (var i = 0; i < b.children.length; i++) {
      if (b.children[i].className.indexOf("wheel-bar") >= 0) return b.children[i];
    }
    return null;
  }
  out.push("progress bar present: " + !!barCell());
  function pipCount(onOnly) {
    var cellEl = barCell(), n = 0;
    (function walk(x) { x.children.forEach(function (c) {
      if (c.className.indexOf("pip") >= 0 && (!onOnly || c.className.indexOf("on") >= 0)) n++;
      walk(c); }); })(cellEl);
    return n;
  }
  out.push("  four pips, " + pipCount(true) + " lit at 1 of 4");
  G.state.sinceWheel = 3;
  G.renderShop();
  out.push("  ready: bar is " + (barCell().className.indexOf("ready") >= 0 ? "highlighted" : "NOT"));
  out.push("  all lit: " + (pipCount(true) === 4));

  // Pressing again mid-spin must be refused — two wheels at once would leave
  // two sequences fighting over the screen.
  G.state.coins = 1000000;
  G.state.sinceWheel = 3;
  G.renderShop();
  function upBtnNow() {
    var b = document.getElementById("upgradeCell");
    return b.children[0].children[b.children[0].children.length - 1];
  }
  var midBefore = G.state.coins;
  upBtnNow().onclick();
  var afterFirst = G.state.coins;
  upBtnNow().onclick();                       // still spinning
  out.push("a second press mid-spin is refused: " +
           (G.state.coins === afterFirst && afterFirst < midBefore));
  __flush();
  out.push("  and once it finishes the shop works again: " +
           (function () {
             G.state.coins = 1000000;
             G.renderShop();
             var was = G.state.coins;
             upBtnNow().onclick();
             __flush();
             return G.state.coins < was;
           })());

  // A tab backgrounded mid-spin can have its timers dropped entirely. The
  // flag carries a deadline so that cannot lock the shop for ever.
  G.state.coins = 1000000;
  G.state.sinceWheel = 3;
  G.renderShop();
  upBtnNow().onclick();
  __timers.length = 0;                       // the animation never finishes
  var realNow = Date.now;
  Date.now = function () { return realNow() + 600000; };   // ten minutes later
  G.state.coins = 1000000;
  G.renderShop();
  var stuckBefore = G.state.coins;
  upBtnNow().onclick();
  __flush();
  Date.now = realNow;
  out.push("after an abandoned spin: " +
           (G.state.coins < stuckBefore ? "recovers and buys again" : "LOCKED"));


  // ── finishing the collection ─────────────────────────────────────────
  out.push("");
  G.state.owned = {};
  G.state.completed = false; G.state.goldSkin = false; G.state.goldOn = false;
  G.show("shop");

  // Locked, and it says how far off you are.
  G.renderGoldRow();
  out.push("gold locked to begin with: " +
           (document.getElementById("goldBtn").textContent === "Locked"));
  out.push("  and it says the score: " + document.getElementById("goldNote").textContent);
  document.getElementById("goldBtn").onclick();
  out.push("  tapping it while locked does nothing: " + (G.state.goldOn === false));

  // Own everything but one.
  var all = [];
  G.sets.forEach(function (st) { st.cards.forEach(function (c) { all.push(c); }); });
  all.forEach(function (c, i) { if (i) G.state.owned[c.id] = 1; });
  out.push("one card short of " + all.length + ": celebrates? " + G.maybeCelebrate());

  // The last card.
  G.state.owned[all[0].id] = 1;
  var fired = G.maybeCelebrate();
  out.push("the last card celebrates: " + fired);
  out.push("  the screen says: " + document.getElementById("doneTitle").textContent);
  out.push("  confetti thrown: " +
           (document.getElementById("confetti").children.length > 0) +
           " (" + document.getElementById("confetti").children.length + " pieces)");
  out.push("  button reads: " + document.getElementById("doneNext").textContent);

  // Step one -> step two: the reward, and where to find it.
  document.getElementById("doneNext").onclick();
  out.push("after Continue: " + document.getElementById("doneTitle").textContent);
  out.push("  tells you where: " +
           (document.getElementById("doneBody").textContent.indexOf("Settings") >= 0));
  out.push("  button now reads: " + document.getElementById("doneNext").textContent);

  document.getElementById("doneNext").onclick();
  out.push("closing it puts the celebration away: " +
           (document.getElementById("doneBack").className.indexOf("show") < 0) +
           ", confetti cleared: " +
           (document.getElementById("confetti").children.length === 0));

  // It must not fire again.
  out.push("it never fires twice: " + (G.maybeCelebrate() === false));

  // Now equippable in settings, and it must reach the canvas.
  G.renderGoldRow();
  out.push("settings now offers it: " + document.getElementById("goldBtn").textContent);
  out.push("  and says it is yours: " + document.getElementById("goldNote").textContent);
  document.getElementById("goldBtn").onclick();
  out.push("turning it on: " + G.state.goldOn +
           ", the bird is gold: " + G.game_gold_probe());
  document.getElementById("goldBtn").onclick();
  out.push("and off again: " + G.state.goldOn +
           ", bird gold: " + G.game_gold_probe());

  // The real path: it must fire when a PULL completes the set, not only when
  // called directly — closeReveal is what actually triggers it in play.
  G.state.owned = {};
  G.state.completed = false; G.state.goldSkin = false; G.state.goldOn = false;
  all.forEach(function (c, i) { if (i) G.state.owned[c.id] = 1; });
  G.state.coins = 1000000;
  G.renderShop();
  // Force the pull to land on the one missing card by owning everything else;
  // whatever comes out, the set is completed either way.
  G.state.owned[all[0].id] = 1;
  var mrow2 = document.getElementById("machines").children[0];
  oneBtn(mrow2).onclick({ currentTarget: oneBtn(mrow2) });
  __flush();
  document.getElementById("pullDone").onclick();     // closes the reveal
  out.push("a pull that completes the set celebrates: " +
           (document.getElementById("doneBack").className.indexOf("show") >= 0));
  document.getElementById("doneNext").onclick();
  document.getElementById("doneNext").onclick();

  // It has to survive a save round trip, and be re-applied on the next run.
  document.getElementById("goldBtn").onclick();
  var reloaded2 = Game.load(Game.save(G.state));
  out.push("worn state survives a save: " +
           (reloaded2.goldOn === true && reloaded2.goldSkin === true));
  G.prepareRun();
  out.push("  and the next run is still gold: " + G.game_gold_probe());


  // ── the new machines ─────────────────────────────────────────────────
  out.push("");
  var baseSets = Game.baseSets(G.sets), gumSets = Game.gumballSets(G.sets);
  out.push("machines: " + baseSets.length + " coin, " + gumSets.length + " gumball");
  out.push("  cards: " + Game.totals(G.state, baseSets).of + " original, " +
           Game.totals(G.state, gumSets).of + " new");

  // Hidden until found.
  G.state.owned = {}; G.state.discovered = false; G.state.gumballs = 0;
  G.state.completed = false;
  G.show("shop");
  out.push("the new group is hidden to begin with: " +
           (document.getElementById("gumGroup").className.indexOf("hidden") >= 0));
  out.push("  and so is the gumball counter: " +
           (document.getElementById("gumWrap").className.indexOf("hidden") >= 0));

  // THE RETURNING PLAYER: already has all 120 and already "completed", but has
  // never seen the gumball machines. This is the case that needs the check on
  // load rather than only at the moment of completion.
  baseSets.forEach(function (st) { st.cards.forEach(function (c) { G.state.owned[c.id] = 1; }); });
  G.state.completed = true;          // they finished it before this update
  G.state.goldSkin = true;
  G.state.discovered = false;
  out.push("a returning player with all " + Game.totals(G.state, baseSets).of + ":");
  out.push("  the celebration stays quiet: " + (G.maybeCelebrate() === false));
  out.push("  but the discovery fires: " + (G.maybeDiscover() === true));
  out.push("  and the warning is on screen: " +
           (document.getElementById("discBack").className.indexOf("show") >= 0));
  document.getElementById("discDone").onclick();
  out.push("  it only fires once: " + (G.maybeDiscover() === false));
  out.push("  the counter is now visible: " +
           (document.getElementById("gumWrap").className.indexOf("hidden") < 0));
  G.renderShop();
  out.push("  and the new machines are listed: " +
           document.getElementById("gumMachines").children.length);

  // Buying gumballs.
  G.state.coins = 5000;
  G.renderShop();
  var gsrcBtn = (function () {
    var c = document.getElementById("gumSource").children[0];
    return c.children[c.children.length - 1];
  })();
  out.push("gumball machine price: " + gsrcBtn.textContent);
  var coinsBefore = G.state.coins, gumsBefore = G.state.gumballs;
  gsrcBtn.onclick();
  out.push("the machine took the screen: " +
           (document.getElementById("capsuleStage").className.indexOf("show") >= 0));
  __flush();
  out.push("  coins " + coinsBefore + " -> " + G.state.coins +
           ((coinsBefore - G.state.coins) === Game.GUMBALL_COST ? "  (1000)" : "  (WRONG)"));
  var got = G.state.gumballs - gumsBefore;
  out.push("  gumballs gained: " + got +
           (got >= Game.GUMBALL_MIN && got <= Game.GUMBALL_MAX ? "  (1-10)" : "  (OUT OF RANGE)"));
  out.push("  and it let the screen go: " +
           (document.getElementById("capsuleStage").className.indexOf("show") < 0));

  // Buying a new machine costs gumballs, not coins.
  G.state.gumballs = 500;
  G.renderShop();
  var gmRow = document.getElementById("gumMachines").children[0];
  var gmBtn = gmRow.children[gmRow.children.length - 1];
  out.push("first new machine price: " + gmBtn.textContent +
           (gmBtn.textContent.indexOf("25") >= 0 ? "  (25 gumballs)" : "  (WRONG)"));
  var coinsWere = G.state.coins, gumsWere = G.state.gumballs;
  var ownedWere = Object.keys(G.state.owned).reduce(function (t,k) { return t + G.state.owned[k]; }, 0);
  gmBtn.onclick({ currentTarget: gmBtn });
  __flush();
  document.getElementById("pullDone").onclick();
  out.push("  gumballs " + gumsWere + " -> " + G.state.gumballs +
           ((gumsWere - G.state.gumballs) === 25 ? "  (25 spent)" : "  (WRONG)"));
  out.push("  coins untouched: " + (G.state.coins === coinsWere));
  var ownedNow = Object.keys(G.state.owned).reduce(function (t,k) { return t + G.state.owned[k]; }, 0);
  out.push("  a card was won: " + (ownedNow === ownedWere + 1));

  // The second new machine costs more.
  G.renderShop();
  var gm2 = document.getElementById("gumMachines").children[1];
  out.push("second new machine price: " + gm2.children[gm2.children.length - 1].textContent);

  // Too few gumballs: refused, nothing taken.
  G.state.gumballs = 1;
  G.renderShop();
  var poorRow = document.getElementById("gumMachines").children[0];
  var poorBtn = poorRow.children[poorRow.children.length - 1];
  poorBtn.onclick({ currentTarget: poorBtn });
  __flush();
  out.push("one gumball short: still have " + G.state.gumballs + ", no reveal: " +
           (document.getElementById("pullBack").className.indexOf("show") < 0));

  out.join("\n");
}